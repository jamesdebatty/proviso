#!/bin/sh
# Usage: .githooks/repair <base>    e.g. .githooks/repair main
# Rewrites <base>..HEAD on the current branch: hardcoded identity, attribution lines removed. Then audits.
# Needs a clean working tree (git filter-branch refuses otherwise) and no backup from an earlier
# repair of this branch at refs/original/<branch>/refs/heads/<branch>.
# Docs: .agents/skills/git-attribution-guardrails/SKILL.md
set -eu
unset CDPATH
[ $# -eq 1 ] || { echo "usage: $0 <base-ref>" >&2; exit 2; }
lib="$(cd "$(dirname "$0")" && pwd)/lib.sh"
# shellcheck source=lib.sh
. "$lib"
# Rewriting to an empty author would be worse than the attribution it removes.
identity_pinned || reject "no identity is pinned, so there is nothing to rewrite commits to" \
  "put your values in .githooks/identity.local.sh, then rerun sh .githooks/install.sh"
branch=$(git symbolic-ref --short HEAD)
backup="refs/original/$branch/refs/heads/$branch"
if git show-ref --quiet --verify "$backup"; then
  reject "$backup holds the backup from an earlier repair" "confirm that backup is no longer needed, then: git update-ref -d $backup"
fi
FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch --original "refs/original/$branch" \
  --env-filter "export GIT_AUTHOR_NAME='$AUTHOR_NAME' GIT_AUTHOR_EMAIL='$AUTHOR_EMAIL' GIT_COMMITTER_NAME='$AUTHOR_NAME' GIT_COMMITTER_EMAIL='$AUTHOR_EMAIL'" \
  --msg-filter ". '$lib' && strip_attribution" \
  "$1..HEAD"
"$(dirname "$lib")/audit" "$1..HEAD"
